# Copy to hr_agent/.env and fill in. Never commit the real .env.
# API key from Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-key-here
# 0 = Gemini Developer API (AI Studio key). Set to 1 for Vertex AI (then project/location are needed).
GOOGLE_GENAI_USE_ENTERPRISE=0

# Optional. Default: gemini-3.5-flash. Any LiteLLM id works, e.g. openai/gpt-4o-mini (needs OPENAI_API_KEY).
# AGENT_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=